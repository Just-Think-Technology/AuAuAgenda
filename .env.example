# Demo without PostgreSQL: data lives in the visitor's browser (localStorage).
# Production must keep MOCKS=false or unset.
MOCKS=false

# PostgreSQL used by the app at runtime (pooled URL on Supabase/Neon is fine).
# Not required when MOCKS=true.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/auauagenda"
# Direct (non-pooled) connection used by Prisma migrations. Defaults to DATABASE_URL when empty.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/auauagenda"

# Secret that signs the session cookie. Use a long random value (e.g. `openssl rand -base64 48`).
JWT_SECRET=""

# Use "1" in production behind a proxy that sets x-real-ip / x-forwarded-for
# with the real client address (Hostinger, Vercel, nginx). Without this, login
# rate limits share one "unknown" IP bucket and do not isolate attackers.
TRUST_PLATFORM_IP=""
